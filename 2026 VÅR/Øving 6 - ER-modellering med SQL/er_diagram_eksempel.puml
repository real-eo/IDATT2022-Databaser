@startuml ER_Diagram
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classBackgroundColor #F0F0F0
skinparam classBorderColor #333333

entity "**borettslag**" as borettslag {
  * borettslag_id : INT <<PK>>
  --
  navn : VARCHAR
  adresse : VARCHAR
  antall_enheter : INT
  etableringsaar : INT
}

entity "**bygning**" as bygning {
  * bygning_id : INT <<PK>>
  * borettslag_id : INT <<FK>>
  --
  adresse : VARCHAR
  antall_etasjer : INT
  antall_leiligheter : INT
}

entity "**leilighet**" as leilighet {
  * leilighet_id : INT <<PK>>
  * bygning_id : INT <<FK>>
  * andelseier_id : INT <<FK>>
  --
  leilighetsnummer : VARCHAR
  antall_rom : INT
  antall_kvm : INT
  etasje : INT
}

entity "**andelseier**" as andelseier {
  * andelseier_id : INT <<PK>>
  --
  fornavn : VARCHAR
  etternavn : VARCHAR
  telefon : VARCHAR
  epost : VARCHAR
  fodselsdato : DATE
}

borettslag ||--o{ bygning : "har"
bygning ||--o{ leilighet : "inneholder"
andelseier ||--o{ leilighet : "eier"

@enduml
